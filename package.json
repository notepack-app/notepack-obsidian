{
  "name": "notepack-obsidian",
  "version": "1.7.1",
  "description": "NotePack plugin for Obsidian - Todo collation with team management",
  "main": "main.js",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "clean": "rm -rf main.js node_modules coverage",
    "test": "pnpm eslint && pnpm jest --verbose",
    "test:coverage": "pnpm jest --coverage",
    "screenshots:render": "tsx screenshots/render.ts",
    "screenshots": "pnpm screenshots:render && wdio run ./wdio.conf.mts",
    "preversion": "node scripts/preversion.js && pnpm test",
    "version": "node scripts/version.js && git add manifest.json",
    "postversion": "node scripts/postversion.js"
  },
  "keywords": [
    "obsidian",
    "notepack",
    "todos",
    "team"
  ],
  "author": {
    "name": "Dave Shepard",
    "url": "htttps://github.com/kynatro"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notepack-app/notepack-obsidian.git"
  },
  "engines": {
    "node": "24",
    "pnpm": "^11.1.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "@typescript-eslint/parser": "^8.59.4",
    "@wdio/cli": "^9.27.1",
    "@wdio/globals": "^9.27.1",
    "@wdio/local-runner": "^9.27.1",
    "@wdio/mocha-framework": "^9.27.1",
    "@wdio/spec-reporter": "^9.27.1",
    "esbuild": "0.28.1",
    "eslint": "^10.2.0",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "globals": "^17.6.0",
    "jest": "^30.3.0",
    "mocha": "^11.7.6",
    "obsidian": "^1.12.3",
    "obsidian-launcher": "^3.0.3",
    "ts-jest": "^29.4.11",
    "tslib": "2.8.1",
    "tsx": "^4.22.3",
    "typescript": "5.9.3",
    "wdio-obsidian-reporter": "^3.0.3",
    "wdio-obsidian-service": "^3.0.3"
  }
}
